<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Background utility: no Dock icon, not even briefly at launch. -->
  <key>LSUIElement</key>
  <true/>
  <!-- Voice Intelligence records from the microphone only when you press Record. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Markdown Companion records your voice only when you start a Voice Intelligence session, so it can transcribe it and turn it into notes.</string>
</dict>
</plist>
